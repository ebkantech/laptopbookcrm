# Copy this file to backend/.env for local development. The real .env file is
# ignored by Git. Hosting platforms should set the same values as process
# environment variables; those take precedence over this local file.

# Safe local-development defaults. Override every production-sensitive value
# in the hosting platform; never deploy with this example secret or DEBUG=True.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_FRONTEND_URL=http://localhost:5173

# Customer portal. In production PUBLIC_FRONTEND_URL can be a branded HTTPS
# origin such as https://portal.vantagecomputers.com after DNS/SSL is set up.
CUSTOMER_PORTAL_BRAND_NAME=Vantage Computers
CUSTOMER_PORTAL_SUPPORT_PHONE=
CUSTOMER_PORTAL_SUPPORT_EMAIL=
CUSTOMER_PHONE_DEFAULT_COUNTRY_CODE=91
CUSTOMER_PORTAL_TOKEN_HOURS=24
CUSTOMER_PORTAL_GRACE_DAYS=30
CUSTOMER_PORTAL_IDLE_SECONDS=1800
CUSTOMER_PORTAL_SESSION_SECONDS=28800

# PostgreSQL (omit these locally to use SQLite)
POSTGRES_DB=crmbook_dev
POSTGRES_USER=crmbook_app
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=False

# JWT and API throttling
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=5/min
CUSTOMER_LOGIN_THROTTLE_RATE=20/hour
CUSTOMER_TOKEN_THROTTLE_RATE=30/hour

# HTTPS security (active when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Email remains console-only unless a real backend is configured.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
