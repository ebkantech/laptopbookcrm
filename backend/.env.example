# Copy this file to backend/.env for local development. The real .env file is
# ignored by Git. Hosting platforms should set the same values as process
# environment variables; those take precedence over this local file.

# Safe local-development defaults. Override every production-sensitive value
# in the hosting platform; never deploy with this example secret or DEBUG=True.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PUBLIC_FRONTEND_URL=http://localhost:5174
DJANGO_SESSION_COOKIE_AGE=28800

# PostgreSQL (omit these locally to use SQLite)
POSTGRES_DB=crmbook_dev
POSTGRES_USER=crmbook_app
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=False

# JWT and API throttling
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=5/min
REPAIR_APPROVAL_THROTTLE_RATE=60/hour
RENTAL_APPROVAL_THROTTLE_RATE=60/hour

# HTTPS security (active when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Email remains console-only unless a real backend is configured.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Seller details printed on sales invoices (per-branch address/phone/GSTIN
# are set on each shop under Admin > Catalog > Stock points).
BUSINESS_NAME=Vantage Computers
BUSINESS_GSTIN=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# UPI payment links on sales invoices (see backend/sales/payments.py).
# sandbox = nothing is sent and no money moves (default, for development);
# razorpay = real UPI-only Razorpay Payment Links, texted to the customer
# by Razorpay. Keys from the Razorpay dashboard > Account & Settings > API keys.
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# For automatic "paid" updates: add a webhook in the Razorpay dashboard to
# https://<your-domain>/api/payments/razorpay-webhook/ for the
# payment_link.paid event, and put its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Checking whether a mobile number has UPI needs a separate lookup service
# (Razorpay can't do it). sandbox = simulated (numbers ending in 0 count as
# "no UPI"); none = staff must confirm with the customer before sending.
UPI_LOOKUP_PROVIDER=sandbox
