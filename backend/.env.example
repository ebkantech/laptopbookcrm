# Set these in the hosting platform or process manager. Django does not load
# this file automatically; it is a documented template, not a secrets file.

# Core
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
PUBLIC_FRONTEND_URL=https://app.yourdomain.com

# PostgreSQL (omit locally to use SQLite)
POSTGRES_DB=crmbook
POSTGRES_USER=crmbook
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT and API throttling
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=5/min

# HTTPS security (active when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Email remains console-only unless a real backend is configured.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
