# Copy this file to backend/.env for local development. The real .env file is
# ignored by Git. Hosting platforms should set the same values as process
# environment variables; those take precedence over this local file.

# Safe local-development defaults. Override every production-sensitive value
# in the hosting platform; never deploy with this example secret or DEBUG=True.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_FRONTEND_URL=http://localhost:5174
DJANGO_SESSION_COOKIE_AGE=28800

# PostgreSQL (omit these locally to use SQLite)
POSTGRES_DB=crmbook_dev
POSTGRES_USER=crmbook_app
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=False

# JWT and API throttling
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=5/min
REPAIR_APPROVAL_THROTTLE_RATE=60/hour
RENTAL_APPROVAL_THROTTLE_RATE=60/hour

# HTTPS security (active when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Email (SMTP). Leave EMAIL_HOST empty to only print emails to the
# runserver console. Setting EMAIL_HOST switches to SMTP automatically.
# Customer portal links need SMTP: the one-time code is emailed.
# Gmail: EMAIL_HOST=smtp.gmail.com, port 587, TLS, and an App Password
# (Google Account > Security > App passwords), not your normal password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Use SSL instead of TLS for port 465 (EMAIL_USE_SSL=True overrides TLS).
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
# Sender shown to customers; defaults to EMAIL_HOST_USER.
DJANGO_DEFAULT_FROM_EMAIL=

# Seller details printed on sales invoices (per-branch address/phone/GSTIN
# are set on each shop under Admin > Catalog > Stock points).
BUSINESS_NAME=Vantage Computers
BUSINESS_GSTIN=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# UPI payment links on sales invoices (see backend/sales/payments.py).
# sandbox = nothing is sent and no money moves (default, for development);
# razorpay = real UPI-only Razorpay Payment Links, texted to the customer
# by Razorpay. Keys from the Razorpay dashboard > Account & Settings > API keys.
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# For automatic "paid" updates: add a webhook in the Razorpay dashboard to
# https://<your-domain>/api/payments/razorpay-webhook/ for the
# payment_link.paid event, and put its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Checking whether a mobile number has UPI needs a separate lookup service
# (Razorpay can't do it). sandbox = simulated (numbers ending in 0 count as
# "no UPI"); none = staff must confirm with the customer before sending;
# cashfree = real lookup with Cashfree Secure ID ("UPI ID from mobile
# number"), keys from the Cashfree Secure ID dashboard > Developers. If the
# lookup fails, staff confirm with the customer instead.
UPI_LOOKUP_PROVIDER=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# production (default) or sandbox (Cashfree's test environment)
CASHFREE_ENV=production

# Days until a sale/repair invoice is due; unpaid after that it's Overdue.
INVOICE_DUE_DAYS=7

# `python manage.py backup` -- where backups go and how many to keep.
# Point BACKUP_DIR at a folder that is itself synced off the machine
# (Google Drive / OneDrive / an external disk).
BACKUP_DIR=
BACKUP_KEEP=14

# Encrypts the short-lived copy of a customer portal code that staff with
# portal.manage can view/copy in the CRM. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable showing codes in the CRM.
PORTAL_OTP_ENCRYPTION_KEY=

# --- WhatsApp (crmbook_backend/notify.py, docs/NOTIFICATIONS.md) ---------
# console = print messages to the runserver terminal, send nothing (default).
# meta_cloud = send for real through Meta's WhatsApp Cloud API.
WHATSAPP_PROVIDER=console
# Meta dashboard > WhatsApp > API Setup. Put the real values in backend/.env
# only -- never commit them. The dashboard's temporary token expires after
# about 24 hours; use a System User token for anything longer-lived.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional: Graph API version (default v25.0) and the country code added to
# 10-digit numbers (default 91).
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Optional approved templates, needed for business-initiated messages
# outside the customer's 24-hour window. Leave blank to send free text.
#   rental approval link: body {{1}} customer name, {{2}} agreement code, {{3}} link
#   portal invite:        body {{1}} customer name, {{2}} portal link, {{3}} link expiry
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_RENTAL_APPROVAL=
WHATSAPP_TEMPLATE_PORTAL_INVITE=
# Shared secret for the delivery-status webhook (portal/whatsapp-webhook/).
WHATSAPP_WEBHOOK_SECRET=
# Meta delivery-status webhook (api/whatsapp/meta-webhook/): a verify token
# you invent and also enter in Meta > WhatsApp > Configuration, and the
# App secret (App settings > Basic) used to check Meta's signatures.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
