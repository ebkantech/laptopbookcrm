# Copy this file to .env (or set these as real environment variables
# in your hosting provider's dashboard) before deploying to production.
# Nothing here is read automatically by manage.py -- either export
# these in your shell/systemd service, or add python-dotenv if you'd
# rather load a .env file automatically.

# --- Core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-value        # e.g. python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Database (PostgreSQL -- omit these to keep using SQLite locally) ---
POSTGRES_DB=crmbook
POSTGRES_USER=crmbook
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE_RATE=5/min

# --- Security headers (only active when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# --- Email (still console-only until a real provider is wired in) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
